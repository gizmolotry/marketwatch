{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketleak.local/schemas/test-receipt-v2.schema.json",
  "title": "Repo Cartographer externally attested pytest receipt v2",
  "description": "Canonical bounded pytest execution facts. receipt_sha256 is payload integrity only; promotion additionally requires a trusted HMAC-SHA256 attestation and an approved runner policy.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "source", "runner", "execution", "selection", "results", "mutation", "receipt_sha256", "attestation"],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeid", "when", "outcome", "wasxfail"],
      "properties": {
        "nodeid": {"type": "string"},
        "when": {"enum": ["setup", "call", "teardown"]},
        "outcome": {"enum": ["passed", "failed", "skipped"]},
        "wasxfail": {"type": "boolean"}
      }
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_uid", "declaration_key", "file_path", "file_sha256", "fixture_only", "nodeid", "line", "original_name"],
      "properties": {
        "test_uid": {"type": "string"},
        "declaration_key": {"$ref": "#/$defs/sha256"},
        "file_path": {"type": "string"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_only": {"type": "boolean"},
        "nodeid": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "original_name": {"type": "string", "minLength": 1}
      }
    },
    "collected_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeid", "file_path", "line", "definition_line", "original_name"],
      "properties": {
        "nodeid": {"type": "string"},
        "file_path": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "definition_line": {"type": "integer", "minimum": 1},
        "original_name": {"type": "string", "minLength": 1}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_uid", "declaration_key", "file_path", "file_sha256", "fixture_only", "nodeid", "line", "original_name", "cases", "fully_passed"],
      "properties": {
        "test_uid": {"type": "string"},
        "declaration_key": {"$ref": "#/$defs/sha256"},
        "file_path": {"type": "string"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_only": {"type": "boolean"},
        "nodeid": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "original_name": {"type": "string", "minLength": 1},
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nodeid", "markers", "phases", "plain_passed"],
            "properties": {
              "nodeid": {"type": "string"},
              "markers": {"type": "array", "items": {"type": "string"}},
              "phases": {"type": "array", "items": {"$ref": "#/$defs/phase"}},
              "plain_passed": {"type": "boolean"}
            }
          }
        },
        "fully_passed": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "format": {"const": "repo-cartographer-pytest-receipt/v2"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_root_sha256", "snapshot_uid", "head_commit", "index_tree", "files_root_sha256", "scan_config_sha256"],
      "properties": {
        "inventory_root_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_uid": {"type": "string"},
        "head_commit": {"type": "string"},
        "index_tree": {"type": "string"},
        "files_root_sha256": {"$ref": "#/$defs/sha256"},
        "scan_config_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_sha256", "config"],
      "properties": {
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "allowed_test_paths", "timeout_seconds", "max_output_bytes", "max_source_files", "max_source_bytes"],
          "properties": {
            "format": {"const": "repo-cartographer-pytest-runner/v2"},
            "allowed_test_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "max_output_bytes": {"type": "integer", "minimum": 1024, "maximum": 10000000},
            "max_source_files": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "max_source_bytes": {"type": "integer", "minimum": 1024, "maximum": 100000000000}
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpreter", "pytest_version", "argv"],
      "properties": {
        "interpreter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "version"],
          "properties": {
            "implementation": {"type": "string"},
            "version": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer"}}
          }
        },
        "pytest_version": {"type": "string"},
        "argv": {"type": "array", "items": {"type": "string"}}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_test_uids", "requested_test_paths", "declarations", "source_files"],
      "properties": {
        "requested_test_uids": {"type": "array", "items": {"type": "string"}},
        "requested_test_paths": {"type": "array", "items": {"type": "string"}},
        "declarations": {"type": "array", "items": {"$ref": "#/$defs/declaration"}},
        "source_files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}
          }
        }
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exit_code", "timed_out", "promotable", "event_file_bytes", "event_file_overflow", "collected_nodeids", "collected_items", "unmapped_nodeids", "collection_errors", "cases"],
      "properties": {
        "exit_code": {"type": "integer"},
        "timed_out": {"type": "boolean"},
        "promotable": {"type": "boolean"},
        "event_file_bytes": {"type": "integer", "minimum": 0},
        "event_file_overflow": {"type": "boolean"},
        "collected_nodeids": {"type": "array", "items": {"type": "string"}},
        "collected_items": {"type": "array", "items": {"$ref": "#/$defs/collected_item"}},
        "unmapped_nodeids": {"type": "array", "items": {"type": "string"}},
        "collection_errors": {"type": "array", "items": {"type": "object"}},
        "cases": {"type": "array", "items": {"$ref": "#/$defs/result"}}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["frozen_copy_unchanged", "changed_paths"],
      "properties": {
        "frozen_copy_unchanged": {"type": "boolean"},
        "changed_paths": {"type": "array", "items": {"type": "string"}}
      }
    },
    "receipt_sha256": {"$ref": "#/$defs/sha256"},
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature"],
      "properties": {
        "algorithm": {"const": "hmac-sha256"},
        "key_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "signature": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
