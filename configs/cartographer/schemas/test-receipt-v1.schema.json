{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Repo Cartographer immutable pytest receipt v1",
  "type":"object","additionalProperties":false,
  "required":["format","source","runner","execution","selection","results","mutation","receipt_sha256"],
  "$defs":{
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "phase":{"type":"object","additionalProperties":false,"required":["nodeid","when","outcome","wasxfail"],"properties":{"nodeid":{"type":"string"},"when":{"enum":["setup","call","teardown"]},"outcome":{"enum":["passed","failed","skipped"]},"wasxfail":{"type":"boolean"}}},
    "declaration":{"type":"object","additionalProperties":false,"required":["test_uid","declaration_key","file_path","file_sha256","fixture_only","nodeid"],"properties":{"test_uid":{"type":"string"},"declaration_key":{"$ref":"#/$defs/sha256"},"file_path":{"type":"string"},"file_sha256":{"$ref":"#/$defs/sha256"},"fixture_only":{"type":"boolean"},"nodeid":{"type":"string"}}}
  },
  "properties":{
    "format":{"const":"repo-cartographer-pytest-receipt/v1"},
    "source":{"type":"object","additionalProperties":false,"required":["inventory_root_sha256","snapshot_uid","head_commit","index_tree","files_root_sha256","scan_config_sha256"],"properties":{"inventory_root_sha256":{"$ref":"#/$defs/sha256"},"snapshot_uid":{"type":"string"},"head_commit":{"type":"string"},"index_tree":{"type":"string"},"files_root_sha256":{"$ref":"#/$defs/sha256"},"scan_config_sha256":{"$ref":"#/$defs/sha256"}}},
    "runner":{"type":"object","additionalProperties":false,"required":["config_sha256","allowed_test_paths","timeout_seconds","max_output_bytes"],"properties":{"config_sha256":{"$ref":"#/$defs/sha256"},"allowed_test_paths":{"type":"array","items":{"type":"string"}},"timeout_seconds":{"type":"integer"},"max_output_bytes":{"type":"integer"}}},
    "execution":{"type":"object","additionalProperties":false,"required":["interpreter","pytest_version","argv"],"properties":{"interpreter":{"type":"object","additionalProperties":false,"required":["implementation","version"],"properties":{"implementation":{"type":"string"},"version":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"integer"}}}},"pytest_version":{"type":"string"},"argv":{"type":"array","items":{"type":"string"}}}},
    "selection":{"type":"object","additionalProperties":false,"required":["requested_test_uids","requested_test_paths","declarations","source_files"],"properties":{"requested_test_uids":{"type":"array","items":{"type":"string"}},"requested_test_paths":{"type":"array","items":{"type":"string"}},"declarations":{"type":"array","items":{"$ref":"#/$defs/declaration"}},"source_files":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["path","sha256"],"properties":{"path":{"type":"string"},"sha256":{"$ref":"#/$defs/sha256"}}}}}},
    "results":{"type":"object","additionalProperties":false,"required":["exit_code","timed_out","promotable","event_file_bytes","event_file_overflow","collected_nodeids","unmapped_nodeids","collection_errors","cases"],"properties":{"exit_code":{"type":"integer"},"timed_out":{"type":"boolean"},"promotable":{"type":"boolean"},"event_file_bytes":{"type":"integer","minimum":0},"event_file_overflow":{"type":"boolean"},"collected_nodeids":{"type":"array","items":{"type":"string"}},"unmapped_nodeids":{"type":"array","items":{"type":"string"}},"collection_errors":{"type":"array","items":{"type":"object"}},"cases":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["test_uid","declaration_key","file_path","file_sha256","fixture_only","nodeid","cases","fully_passed"],"properties":{"test_uid":{"type":"string"},"declaration_key":{"$ref":"#/$defs/sha256"},"file_path":{"type":"string"},"file_sha256":{"$ref":"#/$defs/sha256"},"fixture_only":{"type":"boolean"},"nodeid":{"type":"string"},"cases":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["nodeid","markers","phases","plain_passed"],"properties":{"nodeid":{"type":"string"},"markers":{"type":"array","items":{"type":"string"}},"phases":{"type":"array","items":{"$ref":"#/$defs/phase"}},"plain_passed":{"type":"boolean"}}}},"fully_passed":{"type":"boolean"}}}}}},
    "mutation":{"type":"object","additionalProperties":false,"required":["frozen_copy_unchanged","changed_paths"],"properties":{"frozen_copy_unchanged":{"type":"boolean"},"changed_paths":{"type":"array","items":{"type":"string"}}}},
    "receipt_sha256":{"$ref":"#/$defs/sha256"}
