# Optional server-side LLM integration. Never expose to a browser or raw receipt.
GEMINI_API_KEY=

# Optional server-side Polygon access. Required only for configured chain collection.
POLYGON_RPC_URL=
POLYGONSCAN_API_KEY=
ETHERSCAN_API_KEY=

# Optional server-side Kalshi WebSocket handshake material.
# Generate the timestamp/signature per documented connection; do not store a static signature.
KALSHI_ACCESS_KEY=
KALSHI_PRIVATE_KEY_PATH=
KALSHI_PRIVATE_KEY_PEM=
KALSHI_WEBSOCKET_URL=

# Optional server-side Slack integration.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Optional server-side data and immutable v3 bundle locations.
MARKETLEAK_V2_DATA_ROOT=
MARKETLEAK_V3_BUNDLE_ROOT=
# Safe public, hash-checked recorded review packet used by the read-only demo.
# This path contains no credentials and triggers neither collection nor inference.
MARKETLEAK_V3_REVIEW_CASES_CONFIG=configs/phase15/polymarket_btc65k_review_case.json

# Safety options. Leave unset to use the server defaults.
MARKETLEAK_LEGACY_DEMO=
MARKETLEAK_ENABLE_LEGACY_SAR=
MARKETLEAK_SUSPICIOUS_WALLETS=
